# Copy to .env.local (gitignored) and adjust: cp .env.example .env.local
#
# Every VITE_* value is compiled into the public JS bundle. Only public values
# belong here. The GitHub App client secret, private key and webhook secret
# belong in the backend's .env (dmc-268-api-t3) and must NEVER get a VITE_ prefix.
# GitHub App registration: docs/github-app-setup.md

# mock: sign-in runs against an in-browser mock backend, no GitHub App needed.
# github: real GitHub App sign-in; needs the client ID, the redirect URI and the backend.
VITE_AUTH_MODE=mock

# GitHub App "Client ID" (starts with Iv). Public; required in github mode.
VITE_GITHUB_CLIENT_ID=

# Must exactly match a "Callback URL" in the GitHub App settings. Required in github mode;
# in mock mode it defaults to <current origin>/auth/callback.
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# GitHub App slug, the last part of https://github.com/apps/<slug>. Public; optional.
# When set, the "Connect repository" screen links to the app's installation page, so users
# can give the reviewer access to more repositories. Lowercase letters, digits and hyphens.
VITE_GITHUB_APP_SLUG=

# Backend API base, same-site with the SPA so the refresh cookie is sent.
VITE_API_BASE_URL=/api

# Dev server only (not public, no VITE_ prefix): when set, `pnpm dev` proxies /api to a
# local backend, for example http://localhost:8000. Leave unset in mock mode.
API_PROXY_TARGET=
